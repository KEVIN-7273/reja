<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/main.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <title>Portfolio</title>
  </head>
  <body>
    <div class="frame">
      <div class="main_frame">
        <div class="left_frame">
          <div class="left_1">
            <div class="left_1-1">
              <img
                src="images/profile.png"
                width="156px"
                height="142px"
                alt=""
              />
            </div>
            <div class="left_1-2"><%=user.name%></div>
            <div class="left_1-3"><%=user.profession%></div>
            <div class="left_icons">
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Facebook.svg" class="icon_1" alt="" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Instagram.svg" class="icon_1" alt="" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Twitter.svg" class="icon_1" alt="" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Linkeding.svg" class="icon_1" alt="" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Youtube.svg" class="icon_1" alt="" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Dribbble.svg" class="icon_1" alt="" />
                </div>
              </a>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_2">
            <div class="list_item">
              <div class="item11">Age:</div>
              <div><%=user.age%></div>
            </div>
            <div class="list_item">
              <div class="item11">Residance:</div>
              <div><%=user.residence%></div>
            </div>
            <div class="list_item">
              <div class="item11">Freelance:</div>
              <div style="color: #7eb942"><%=user.freelance%></div>
            </div>
            <div class="list_item">
              <div class="item11">Address:</div>
              <div><%=user.adress%></div>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_3">
            <div class="language">Languages</div>
            <div class="left_3_items">
              <div>Uzbek</div>
              <div>100%</div>
            </div>
            <div class="chiziq"><div class="chiziq_ichi"></div></div>
            <div class="left_3_items">
              <div>Korean</div>
              <div>80%</div>
            </div>
            <div class="chiziq"><div class="chiziq_ichi2"></div></div>
            <div class="left_3_items">
              <div>English</div>
              <div>60%</div>
            </div>
            <div class="chiziq"><div class="chiziq_ichi3"></div></div>
          </div>
          <div class="marginer"></div>
          <div class="left_4">
            <div class="language">Skills</div>
            <div class="left_3_items">
              <div>HTML</div>
              <div>100%</div>
            </div>
            <div class="chiziq"><div class="chiziq_ichi"></div></div>
            <div class="left_3_items">
              <div>CSS</div>
              <div>85%</div>
            </div>
            <div class="chiziq"><div class="chiziq_ichi2"></div></div>
            <div class="left_3_items">
              <div>JS</div>
              <div>60%</div>
            </div>
            <div class="chiziq"><div class="chiziq_ichi3"></div></div>
            <div class="left_3_items">
              <div>PHP</div>
              <div>60%</div>
            </div>
            <div class="chiziq"><div class="chiziq_ichi3"></div></div>
            <div class="left_3_items">
              <div>WordPress</div>
              <div>85%</div>
            </div>
            <div class="chiziq"><div class="chiziq_ichi2"></div></div>
          </div>
          <div class="marginer"></div>
          <div class="left_5">
            <div>
              <div class="language">Extra Skills</div>
            </div>
            <div class="left5_5_items">
              <div class="left_5_item">
                <div><img src="icon/icons.svg" alt="" /></div>
                <div class="left_5_text">Bootstrap, Materialize</div>
              </div>
              <div class="left_5_item">
                <div><img src="icon/icons.svg" alt="" /></div>
                <div class="left_5_text">Stylus, Sass, Less</div>
              </div>
              <div class="left_5_item">
                <div><img src="icon/icons.svg" alt="" /></div>
                <div class="left_5_text">Gulp, Webpack, Grunt</div>
              </div>
              <div class="left_5_item">
                <div><img src="icon/icons.svg" alt="" /></div>
                <div class="left_5_text">GIT Knowledge</div>
              </div>
            </div>
          </div>
          <div class="marginer"></div>
        </div>
        <div class="midd_frame"></div>
        <div class="right_frame"></div>
      </div>
    </div>
  </body>
</html>
